generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model CustomerAccount {
  id             Int @id @default(autoincrement())
  email          String @unique @db.VarChar(150)
  passwordHash   String @map("password_hash")
  customerId     Int? @unique @map("customer_id")
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pendingProfile Json? @map("pending_profile")
  verifiedAt     DateTime? @map("verified_at")
  sessionVersion Int @default(0) @map("session_version")
  failedAttempts Int @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime @default(now()) @map("created_at")
  challenges     AccountChallenge[]
  @@map("customer_accounts")
}

model AccountChallenge {
  id         String @id @db.Uuid
  accountId  Int @map("account_id")
  account    CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose    String
  email      String @db.VarChar(150)
  codeHash   String @map("code_hash")
  attempts   Int @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  resetHash  String? @unique @map("reset_hash")
  @@unique([accountId, purpose])
  @@index([expiresAt])
  @@map("account_challenges")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  active    Boolean   @default(true)
  createdAt DateTime  @default(dbgenerated("timezone('UTC'::text, now())")) @map("created_at")
  updatedAt DateTime  @default(dbgenerated("timezone('UTC'::text, now())")) @updatedAt @map("updated_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id              Int               @id @default(autoincrement())
  name            String
  brand           String
  description     String?
  imageUrl        String?           @map("image_url")
  categoryId      Int               @map("category_id")
  price           Decimal           @db.Decimal(10, 2)
  cost            Decimal?          @db.Decimal(10, 2)
  unit            String
  unitDescription String?           @map("unit_description")
  minQty          Int               @default(1) @map("min_qty")
  stock           Int               @default(0)
  active          Boolean           @default(true)
  bestSeller      Boolean           @default(false) @map("best_seller")
  featured        Boolean           @default(false)
  stars           Int               @default(5)
  archivedAt      DateTime?         @map("archived_at")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(dbgenerated("timezone('UTC'::text, now())")) @map("created_at")
  updatedAt       DateTime          @default(dbgenerated("timezone('UTC'::text, now())")) @updatedAt @map("updated_at")
  orderItems      OrderItem[]
  flavors         ProductFlavor[]
  category        Category          @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  saleItems       SaleItem[]
  stockMovements  StockMovement[]

  @@index([categoryId], map: "products_category_idx")
  @@index([categoryId, name], map: "products_store_idx", where: raw("(active AND (deleted_at IS NULL))"))
  @@map("products")
}

model ProductFlavor {
  id               Int               @id @default(autoincrement())
  productId        Int               @map("product_id")
  name             String
  active           Boolean           @default(true)
  createdAt        DateTime          @default(dbgenerated("timezone('UTC'::text, now())")) @map("created_at")
  updatedAt        DateTime          @default(dbgenerated("timezone('UTC'::text, now())")) @updatedAt @map("updated_at")
  orderItemFlavors OrderItemFlavor[]
  product          Product           @relation(fields: [productId], references: [id], onUpdate: NoAction)
  saleItems        SaleItem[]

  @@unique([productId, name])
  @@map("product_flavors")
}

model AdminUser {
  sessions        AdminSession[]
  id              Int               @id @default(autoincrement())
  name            String
  username        String            @unique
  passwordHash    String            @map("password_hash")
  active          Boolean           @default(true)
  failedAttempts  Int               @default(0) @map("failed_attempts")
  lockedUntil     DateTime?         @map("locked_until")
  lastLoginAt     DateTime?         @map("last_login_at")
  createdAt       DateTime          @default(dbgenerated("timezone('UTC'::text, now())")) @map("created_at")
  updatedAt       DateTime          @default(dbgenerated("timezone('UTC'::text, now())")) @updatedAt @map("updated_at")
  sales           Sale[]
  stockMovements  StockMovement[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   Int       @map("admin_id")
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([adminId], map: "admin_sessions_admin_id_idx")
  @@index([expiresAt], map: "admin_sessions_expires_at_idx")
  @@map("admin_sessions")
}

model Customer {
  id              Int          @id @default(autoincrement())
  code            String       @unique
  type            CustomerType
  name            String
  tradeName       String?      @map("trade_name")
  responsibleName String?      @map("responsible_name")
  document        String?      @unique @db.VarChar(14)
  phone           String       @db.VarChar(20)
  email           String?
  notes           String?
  active          Boolean      @default(true)
  zip             String?      @db.VarChar(8)
  street          String?
  streetNumber    String?      @map("street_number")
  complement      String?
  neighborhood    String?
  city            String?
  state           String?      @db.VarChar(2)
  createdAt       DateTime     @default(dbgenerated("timezone('UTC'::text, now())")) @map("created_at")
  updatedAt       DateTime     @default(dbgenerated("timezone('UTC'::text, now())")) @updatedAt @map("updated_at")
  orders          Order[]
  sales           Sale[]
  account         CustomerAccount?

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Order {
  id           Int          @id @default(autoincrement())
  requestId    String?      @unique @map("request_id")
  status       OrderStatus  @default(REQUESTED)
  customerId   Int?         @map("customer_id")
  customerType CustomerType @map("customer_type")
  customerName String       @map("customer_name")
  document     String?      @db.VarChar(14)
  phone        String       @db.VarChar(15)
  zip          String       @db.VarChar(8)
  street       String
  streetNumber String       @map("street_number")
  complement   String?
  neighborhood String?
  city         String
  state        String       @db.VarChar(2)
  createdAt    DateTime     @default(dbgenerated("timezone('UTC'::text, now())")) @map("created_at")
  updatedAt    DateTime     @default(dbgenerated("timezone('UTC'::text, now())")) @updatedAt @map("updated_at")
  items        OrderItem[]
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sale         Sale?

  @@index([customerId], map: "orders_customer_idx")
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "orders_date_idx")
  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "orders_status_date_idx")
  @@map("orders")
}

model OrderItem {
  id            Int               @id @default(autoincrement())
  orderId       Int               @map("order_id")
  productId     Int               @map("product_id")
  productName   String            @map("product_name")
  brand         String
  description   String?
  unit          String
  minQty        Int               @map("min_qty")
  unitPrice     Decimal?          @map("unit_price") @db.Decimal(10, 2)
  totalQuantity Int               @map("total_quantity")
  createdAt     DateTime          @default(dbgenerated("timezone('UTC'::text, now())")) @map("created_at")
  flavors       OrderItemFlavor[]
  order         Order             @relation(fields: [orderId], references: [id], onUpdate: NoAction)
  product       Product           @relation(fields: [productId], references: [id], onUpdate: NoAction)

  @@unique([orderId, productId])
  @@index([productId], map: "order_items_product_idx")
  @@map("order_items")
}

model OrderItemFlavor {
  id          Int            @id @default(autoincrement())
  orderItemId Int            @map("order_item_id")
  flavorId    Int?           @map("flavor_id")
  flavorName  String?        @map("flavor_name")
  quantity    Int
  createdAt   DateTime       @default(dbgenerated("timezone('UTC'::text, now())")) @map("created_at")
  flavor      ProductFlavor? @relation(fields: [flavorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id], onUpdate: NoAction)

  @@unique([orderItemId, flavorId])
  @@index([flavorId], map: "order_item_flavors_flavor_idx")
  @@map("order_item_flavors")
}

model Sale {
  id                Int               @id @default(autoincrement())
  code              String            @unique
  customerId        Int               @map("customer_id")
  orderId           Int?              @unique @map("order_id")
  saleDate          DateTime          @default(dbgenerated("((now() AT TIME ZONE 'America/Sao_Paulo'::text))::date")) @map("sale_date") @db.Date
  customerName      String            @map("customer_name")
  customerPhone     String            @map("customer_phone") @db.VarChar(20)
  customerDocument  String?           @map("customer_document") @db.VarChar(14)
  deliveryAddress   Json              @default("{}") @map("delivery_address")
  subtotal          Decimal           @default(0) @db.Decimal(10, 2)
  discount          Decimal           @default(0) @db.Decimal(10, 2)
  deliveryFee       Decimal           @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  total             Decimal           @default(0) @db.Decimal(10, 2)
  paymentMethod     String?           @map("payment_method")
  paymentStatus     PaymentStatus     @default(PENDING) @map("payment_status")
  paidAmount        Decimal           @default(0) @map("paid_amount") @db.Decimal(10, 2)
  status            SaleStatus        @default(DRAFT)
  notes             String?
  createdById       Int               @map("created_by_id")
  createdAt         DateTime          @default(dbgenerated("timezone('UTC'::text, now())")) @map("created_at")
  updatedAt         DateTime          @default(dbgenerated("timezone('UTC'::text, now())")) @updatedAt @map("updated_at")
  items             SaleItem[]
  createdBy         AdminUser         @relation(fields: [createdById], references: [id], onUpdate: NoAction)
  customer          Customer          @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  order             Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  stockMovements    StockMovement[]

  @@index([createdById], map: "sales_admin_idx")
  @@index([customerId, saleDate(sort: Desc)], map: "sales_customer_date_idx")
  @@index([paymentStatus], map: "sales_payment_idx", where: raw("(status = ANY (ARRAY['CONFIRMED'::sale_status, 'DELIVERED'::sale_status]))"))
  @@index([status, saleDate(sort: Desc)], map: "sales_status_date_idx")
  @@map("sales")
}

model SaleItem {
  id          Int            @id @default(autoincrement())
  saleId      Int            @map("sale_id")
  productId   Int?           @map("product_id")
  flavorId    Int?           @map("flavor_id")
  productName String         @map("product_name")
  brand       String?
  unit        String?
  description String?
  flavorName  String?        @map("flavor_name")
  notes       String?
  quantity    Decimal        @db.Decimal(12, 3)
  unitPrice   Decimal        @map("unit_price") @db.Decimal(10, 2)
  unitCost    Decimal?       @map("unit_cost") @db.Decimal(10, 2)
  subtotal    Decimal        @db.Decimal(10, 2)
  createdAt   DateTime       @default(dbgenerated("timezone('UTC'::text, now())")) @map("created_at")
  flavor      ProductFlavor? @relation(fields: [flavorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product     Product?       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sale        Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([flavorId], map: "sale_items_flavor_idx")
  @@index([productId], map: "sale_items_product_idx")
  @@index([saleId], map: "sale_items_sale_idx")
  @@map("sale_items")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(dbgenerated("timezone('UTC'::text, now())")) @map("created_at")
  updatedAt DateTime @default(dbgenerated("timezone('UTC'::text, now())")) @updatedAt @map("updated_at")

  @@map("settings")
}

/// Imutável no banco (trigger). Toda alteração de estoque passa por confirm_sale, cancel_sale ou adjust_stock.
/// Tem CHECKs, comentários e RLS no banco que o Prisma não reproduz.
model StockMovement {
  id          BigInt     @id @default(autoincrement())
  productId   Int        @map("product_id")
  saleId      Int?       @map("sale_id")
  kind        String
  quantity    Int
  stockBefore Int        @map("stock_before")
  stockAfter  Int        @map("stock_after")
  reason      String
  createdById Int?       @map("created_by_id")
  createdAt   DateTime   @default(dbgenerated("timezone('UTC'::text, now())")) @map("created_at")
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product     Product    @relation(fields: [productId], references: [id], onUpdate: NoAction)
  sale        Sale?      @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([saleId, productId, kind], map: "stock_movements_sale_once_idx", where: raw("(sale_id IS NOT NULL)"))
  @@index([createdById], map: "stock_movements_admin_idx")
  @@index([productId, createdAt(sort: Desc)], map: "stock_movements_product_date_idx")
  @@map("stock_movements")
}

/// Tem CHECKs e RLS no banco que o Prisma não reproduz.
model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  city      String?
  stars     Int
  text      String
  avatar    String?
  published Boolean  @default(false)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(dbgenerated("timezone('UTC'::text, now())")) @map("created_at")
  updatedAt DateTime @default(dbgenerated("timezone('UTC'::text, now())")) @map("updated_at")

  @@map("testimonials")
}

enum CustomerType {
  PF
  PJ

  @@map("customer_type")
}

enum OrderStatus {
  REQUESTED
  CONFIRMED
  CANCELED

  @@map("order_status")
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELED

  @@map("sale_status")
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID

  @@map("payment_status")
}
